# CSYE 6225 - Assignment 4
# Provided complete. Do not modify.
#
# This assignment uses your AWS account's default VPC rather than building
# a custom one - custom VPC design is covered in Module 5. This file looks
# up that default VPC and its subnets, and defines the security group your
# instance will use.

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

resource "aws_security_group" "app_sg" {
  name        = "prompt-optimizer-sg"
  description = "Allow inbound HTTP and SSH for Assignment 4"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "prompt-optimizer-sg"
  }
}
