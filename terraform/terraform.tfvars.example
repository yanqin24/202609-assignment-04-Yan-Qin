# CSYE 6225 - Assignment 4
#
# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars IS committed to your repo (it contains no secrets -
# your AMI ID and key pair name are not sensitive) and is what GitHub
# Actions uses when it runs `terraform apply` on push.

ami_id   = "ami-REPLACE_WITH_YOUR_PACKER_AMI_ID"
key_name = "REPLACE_WITH_YOUR_EC2_KEY_PAIR_NAME"
